# ── LLM provider ──────────────────────────────────────────────────────────────
# Which LLM backend BOB uses:
#   nvidia – primary/default: NVIDIA NIM hosted API (requires NVIDIA_API_KEY)
#   ollama – alternative: local Ollama server (no API key needed)
# Default: nvidia
LLM_PROVIDER=nvidia

# ── NVIDIA NIM configuration (primary provider) ──────────────────────────────
# NVIDIA's hosted API endpoint (https://integrate.api.nvidia.com), intended for
# development and testing. Access, quotas and rate limits are set by NVIDIA and
# your NVIDIA account. Create a key at https://build.nvidia.com . Never commit it.
NVIDIA_API_KEY=
# Any NVIDIA-hosted chat model with tool calling. Default: openai/gpt-oss-20b
# Verified end-to-end with BOB tool calling. Latency: ~3.5s simple / ~5s with tools.
NVIDIA_MODEL=openai/gpt-oss-20b
# Secondary model (lower latency for routing hints, set via NVIDIA_MODEL to switch):
# NVIDIA_MODEL=z-ai/glm-5.3-flash
# Request timeout in seconds.  Default: 120
# NVIDIA_TIMEOUT=120

# ── Ollama configuration (used when LLM_PROVIDER=ollama) ─────────────────────
# Base URL of the local Ollama server.
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Model tag to use.  Run `ollama list` to see what is installed.
# Default: qwen2.5-coder:7b
OLLAMA_MODEL=qwen2.5-coder:7b

# Request timeout in seconds.  Increase for slower machines.
# Default: 120
OLLAMA_TIMEOUT=120

# ── BOB configuration ─────────────────────────────────────────────────────────
# Override the system prompt sent to the LLM at the start of every session.
# Leave blank to use the built-in default.
# BOB_SYSTEM_PROMPT=You are BOB, a helpful local AI assistant.
# (Legacy alias: JARVIS_SYSTEM_PROMPT)

# Logging level.  Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: WARNING
BOB_LOG_LEVEL=WARNING
# (Legacy alias: JARVIS_LOG_LEVEL)

# Laya request router: a fast local classifier (GPU) that gives the LLM a routing
# hint for each new request. Needs the optional `laya` package and CUDA; without
# them BOB simply runs without routing. Set to false to disable it.
# Default: true
# BOB_LAYA_ROUTER=true

# ── Voice / Speech-to-Text (STT) configuration ───────────────────────────────
# Whisper model to use for local transcription.
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, large-v3
# Recommended for RTX 3050 (4 GB VRAM) / 16 GB RAM: base (or tiny for fastest speed)
# Default: base
WHISPER_MODEL=base

# Device to run Whisper on: auto, cuda, cpu
# 'auto' attempts CUDA first with safe fallback to CPU if CUDA runtime is missing.
# Default: auto
WHISPER_DEVICE=auto

# Precision/quantization: auto, float16, int8_float16, int8
# On CPU, 'auto' selects int8 for low memory and high speed.
# Default: auto
WHISPER_COMPUTE_TYPE=auto

# Spoken language code (e.g. en, es, fr, de, hi).
# Leave commented out for automatic language detection.
# WHISPER_LANGUAGE=en

# Microphone index override (leave commented out to use Windows default microphone)
# AUDIO_INPUT_DEVICE=1

# Silence detection threshold (RMS energy, typically 0.01 to 0.03)
# AUDIO_SILENCE_THRESHOLD=0.015

# Seconds of silence after speech to trigger end-of-speech
# AUDIO_SILENCE_DURATION=1.2

# ── Voice / Text-to-Speech (TTS) configuration ───────────────────────────────
# Piper voice model to use for local neural speech synthesis.
# Recommended lightweight English voice: en_US-lessac-medium
# Other options: en_US-lessac-low, en_US-amy-medium, en_GB-alan-medium
# Default: en_US-lessac-medium
PIPER_VOICE=en_US-lessac-medium

# Directory where Piper ONNX voice models are stored.
# Default: models/piper
PIPER_VOICES_DIR=models/piper

# Run Piper on CUDA GPU (true/false).
# On CPU, Piper synthesizes sentences in ~100ms.
# Default: false
PIPER_USE_CUDA=false

# Speaking speed rate (1.0 = normal, 0.9 = faster, 1.1 = slower).
# Default: 1.0
PIPER_LENGTH_SCALE=1.0

# Automatically speak responses aloud for typed messages as well (true/false).
# (Note: microphone 'voice' command always speaks the reply aloud regardless).
# Default: false
BOB_VOICE_REPLY=false
# (Legacy alias: JARVIS_VOICE_REPLY)

# ── Search configuration ──────────────────────────────────────────────────────
# Extra semicolon- or comma-separated root directories for the search_computer tool.
# BOB_SEARCH_ROOTS=C:\Projects;E:\Work
# (Legacy alias: JARVIS_SEARCH_ROOTS)
